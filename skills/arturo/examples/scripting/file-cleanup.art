; Run only in a disposable, exclusive working directory.
cleanupOwnedFiles: $[paths :block][
    failures: []
    loop paths 'ownedPath [
        failure: try [
            delete ownedPath
            ; A normal return from delete does not prove removal succeeded.
            if exists? ownedPath -> throw "owned path remains after cleanup"
        ]
        if error? failure -> 'failures ++ #[path: ownedPath cause: failure]
    ]
    return failures
]

runCleanupWorkflow: $[failAction? :logical failCleanup? :logical][
    firstPath: "cleanup-first.txt"
    secondPath: "cleanup-second.txt"
    ensure -> not? exists? firstPath
    ensure -> not? exists? secondPath
    owned: @[firstPath secondPath]
    value: null
    actionError: try [
        write "first" firstPath
        write "second" secondPath
        ensure -> "first" = read.file firstPath
        if failCleanup? [
            ; Deterministic wrong-kind fixture, independent of user permissions.
            delete firstPath
            ensure -> not? exists? firstPath
            write.directory null firstPath
            ensure -> directory? firstPath
        ]
        ; A real write failure: a regular file cannot contain a child file.
        if failAction? -> write "blocked" secondPath ++ "/child.txt"
        value: read.file secondPath
    ]
    cleanupErrors: cleanupOwnedFiles owned
    ensure -> owned = @[firstPath secondPath]
    return #[value: value actionError: actionError cleanupErrors: cleanupErrors]
]

; Empty and already-absent inputs are successful and remain unchanged.
ensure -> [] = cleanupOwnedFiles []
absent: ["cleanup-absent.txt"]
ensure -> not? exists? first absent
ensure -> [] = cleanupOwnedFiles absent
ensure -> absent = ["cleanup-absent.txt"]

; Exercise action success/failure crossed with cleanup success/failure.
loop @[false true] 'failAction? [
    loop @[false true] 'failCleanup? [
        report: runCleanupWorkflow failAction? failCleanup?
        ensure -> failAction? = error? report\actionError
        failAction? ?
            -> ensure -> null? report\value
            -> ensure -> report\value = "second"
        ; Cleanup of the second file must run even if the first removal failed.
        ensure -> not? exists? "cleanup-second.txt"
        failCleanup? ? [
            ensure -> 1 = size report\cleanupErrors
            issue: first report\cleanupErrors
            ensure -> issue\path = "cleanup-first.txt"
            ensure -> error? issue\cause
            ensure -> issue\cause\message = "owned path remains after cleanup"
            if failAction? -> ensure -> not? (report\actionError\message = issue\cause\message)
            ensure -> directory? "cleanup-first.txt"
            ; The test owns this empty directory and removes it explicitly.
            delete.directory "cleanup-first.txt"
        ][
            ensure -> empty? report\cleanupErrors
        ]
        ensure -> not? exists? "cleanup-first.txt"
    ]
]

; Function-local collectors do not replace caller bindings or mutate inputs.
failures: "outside"
ownedPath: "outside"
ensure -> [] = cleanupOwnedFiles absent
ensure -> failures = "outside"
ensure -> ownedPath = "outside"
ensure -> absent = ["cleanup-absent.txt"]
print "file cleanup ok"
