; Grouping changes the result; aliases have no conventional precedence.
ensure -> 10 = (2 * 3) + 4
; Compare the named functions with their symbolic forms below.
ensure -> 14 = mul 2 add 3 4
ensure -> 2 = 5 / 2
ensure -> 2.5 = 5 // 2
ensure -> 14 = 2 * 3 + 4
ensure -> 8 = 2 ^ 3
ensure -> 2 = and 2 3
ensure -> 16 = shl 2 3
ensure -> 12 = gcd [48 60 120]
ensure -> 24 = ∏ 1..4
ensure -> 2.5 = average [1 2 3 4]
ensure -> 2.5 = median sort [4 1 3 2]
ensure -> 1.25 = variance [1 2 3 4]

; Value arguments return a result; a supported literal mutates its binding.
amount: 5
increased: amount + 2
ensure -> amount = 5
ensure -> increased = 7
'amount + 2
ensure -> amount = 7

; Conversion is explicit and is not rounding.
ensure -> 42 = to :integer "42"
ensure -> 4 = to :integer 4.9
ensure -> (neg 4) = to :integer neg 4.9
ensure -> :floating = type to :floating 4
ensure -> "4 units" = (to :string 4) ++ " units"
rawInput: "not-a-number"
parsed: 42
conversionError: try -> parsed: to :integer rawInput
ensure -> error? conversionError
ensure -> rawInput = "not-a-number"
ensure -> parsed = 42
ensure -> error? try -> 5 / 0

; Reducer identities differ from undefined statistics.
samples: [4 1 3 2]
ensure -> 2.5 = average samples
ensure -> 2.5 = median sort samples
ensure -> 1.25 = variance samples
ensure -> samples = [4 1 3 2]
ensure -> 0 = ∑ []
ensure -> 1 = ∏ []
ensure -> 7.0 = average [7]
ensure -> 0.0 = variance [7]
ensure -> 2.0 = variance.sample [1 3]
; The runtime returns zero here, although sample variance requires two values.
ensure -> 0.0 = variance.sample [7]
emptySamples: []
ensure -> error? try -> average emptySamples
ensure -> emptySamples = []
print "math ok"
