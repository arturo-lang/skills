ensure [14 = 2 * 3 + 4]
ensure [10 = (2 * 3) + 4]
double: function [x][x * 2]
ensure [8 = double 4]
scopeValue: 1
do [scopeValue: 2]
ensure [scopeValue = 2]
localValue: function [][
    scopeValue: 3
    return scopeValue
]
ensure [3 = localValue]
ensure [scopeValue = 2]
original: [3 1 2]
ordered: sort original
ensure [original = [3 1 2]]
ensure [ordered = [1 2 3]]
copy: new original
sort 'copy
ensure [original = [3 1 2]]
ensure [copy = [1 2 3]]
ensure [between? 2 1 3]
ensure [not? same? 3 3.0]
ensure [and? true true]
ensure [is? :integer to :integer "42"]
print "language ok"
